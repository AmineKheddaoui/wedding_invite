# Configuration du serveur Faire-Part Numérique
# Copiez ce fichier en .env et modifiez les valeurs

# Port du serveur API
PORT=3001

# Mot de passe admin pour accéder au dashboard
# IMPORTANT: Changez cette valeur en production !
ADMIN_PASSWORD=admin123

# Chemin de la base de données SQLite
DB_PATH=./data/rsvp.db

# Environnement (development ou production)
NODE_ENV=development
